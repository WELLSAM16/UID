rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tahap 1 — akun & role UID Jaya (login NIP, tanpa self-register).
    // Dokumen users hanya ditulis via Admin SDK (/api/users); client hanya
    // boleh membaca milik sendiri + menandai mustChangePassword milik sendiri
    // setelah ganti password. Admin (administrator/admin_uid) boleh list semua.
    function isAdminRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["administrator", "admin_uid", "admin"];
    }
    // Super admin (administrator) — satu-satunya yang boleh membaca daftar users.
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["administrator", "admin"];
    }
    match /users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isSuperAdmin());
      allow create: if false;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["mustChangePassword"])
        && request.resource.data.mustChangePassword == false;
      allow delete: if false;
    }

    // Request pembuatan akun (publik mengajukan, admin menyetujui).
    // Ditulis via Admin SDK (/api/account-requests) agar bisa rate-limit +
    // validasi server; client langsung ditolak. Baca/tulis langsung hanya admin.
    // Field phone/waStatus disiapkan untuk fase kirim via WA berikutnya.
    match /account_requests/{reqId} {
      allow create: if false;
      allow read: if request.auth != null && isAdminRole();
      allow update, delete: if false;
    }
    match /monitored_accounts/{doc} {
      // Monitoring data: any signed-in user can read; only admin can write.
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdminRole();
    }

    // Draft workflow 2 tahap: owner + admin, SLA 7 hari + retensi TTL 90 hari.
    // Tahap 1 (SLA): pending -> expired otomatis (lazy di API) bila lewat slaExpiresAt.
    // Tahap 2 (retensi): approved/rejected/published/expired dihapus via TTL
    //   pada field retentionExpiresAt (penghapusan TTL oleh sistem, bypass rules).
    // expired adalah status terminal: tidak ada transisi client dari/ke expired
    // (duplikat dilakukan via API membuat dokumen BARU).
    match /content_drafts/{draftId} {
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == "draft";
      allow read: if request.auth != null
        && (resource.data.authorUid == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["administrator", "admin_uid", "admin"]);
      allow update: if request.auth != null
        && resource.data.status != "expired"
        && request.resource.data.status != "expired"
        && request.resource.data.authorUid == resource.data.authorUid
        && (
        // Owner edits own draft while still draft/rejected
        (resource.data.authorUid == request.auth.uid
          && resource.data.status in ["draft", "rejected"]
          && request.resource.data.status in ["draft", "pending"])
        // Admin reviews pending drafts (belum lewat SLA, bukan karya sendiri)
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["administrator", "admin_uid", "admin"]
          && resource.data.status == "pending"
          && request.resource.data.status in ["approved", "rejected"]
          && resource.data.authorUid != request.auth.uid
          && (resource.data.slaExpiresAt == null || request.time < resource.data.slaExpiresAt))
        // Admin publishes approved drafts
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["administrator", "admin_uid", "admin"]
          && resource.data.status == "approved"
          && request.resource.data.status == "published")
      );
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["administrator", "admin_uid", "admin"]
        || (resource.data.authorUid == request.auth.uid
          && resource.data.status in ["draft", "rejected"])
      );
    }

    // Target skoring: semua user login boleh baca; hanya admin boleh tulis.
    // (Akses utama lewat API /api/targets; rules ini pengaman akses langsung.)
    match /skoring_targets/{targetId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["administrator", "admin_uid", "admin"];
    }

    // Draf press release: pola sama seperti content_drafts (SLA 7 hari + TTL 90 hari).
    match /press_release_drafts/{draftId} {
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == "draft";
      allow read: if request.auth != null
        && (resource.data.authorUid == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["administrator", "admin_uid", "admin"]);
      allow update: if request.auth != null
        && resource.data.status != "expired"
        && request.resource.data.status != "expired"
        && request.resource.data.authorUid == resource.data.authorUid
        && (
        (resource.data.authorUid == request.auth.uid
          && resource.data.status in ["draft", "rejected"]
          && request.resource.data.status in ["draft", "pending"])
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["administrator", "admin_uid", "admin"]
          && resource.data.status == "pending"
          && request.resource.data.status in ["approved", "rejected"]
          && resource.data.authorUid != request.auth.uid
          && (resource.data.slaExpiresAt == null || request.time < resource.data.slaExpiresAt))
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["administrator", "admin_uid", "admin"]
          && resource.data.status == "approved"
          && request.resource.data.status == "published")
      );
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["administrator", "admin_uid", "admin"]
        || (resource.data.authorUid == request.auth.uid
          && resource.data.status in ["draft", "rejected"])
      );
    }

    // Sumber spreadsheet monitoring press release: semua user login boleh baca
    // (untuk dropdown); hanya admin boleh tulis.
    // (Akses utama lewat API /api/press-release-sources; rules ini pengaman akses langsung.)
    match /press_release_sources/{sourceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["administrator", "admin_uid", "admin"];
    }

    // Default deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
